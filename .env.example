# Copiá este archivo a .env (nunca se commitea) y completá con tus credenciales reales.
# Sin estas 4 variables, la CLI usa el store JSON local (data/) sin necesidad de DB.

DB_HOST=
DB_PORT=1433
DB_USER=
DB_PASSWORD=
DB_NAME=dbRemoteJobHub
# En false si la instancia usa un certificado autofirmado (típico on-prem sin CA propia)
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=true

# API HTTP (packages/api)
PORT=3100
